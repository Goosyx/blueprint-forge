# PT: Copie para .env e troque a senha. O .env nunca vai para o git.
# EN: Copy to .env and change the password. .env never goes into git.
BF_DB_USER=blueprint_forge
BF_DB_PASSWORD=ChangeMeAdminPassword1
BF_DB_NAME=blueprint_forge
BF_DB_PORT=5433
# PT: Superusuário do contêiner: só para preparar o banco e para os testes.
# EN: Container superuser: only to prepare the database and for tests.
BF_ADMIN_DATABASE_URL=postgres://blueprint_forge:ChangeMeAdminPassword1@127.0.0.1:5433/blueprint_forge
# PT: Usuário das migrations (sem superusuário; 16+ letras ou dígitos).
# EN: Migrations user (no superuser; 16+ letters or digits).
BF_MIGRATE_DB_PASSWORD=ChangeMeMigratePassword1
BF_MIGRATE_DATABASE_URL=postgres://bf_migrate:ChangeMeMigratePassword1@127.0.0.1:5433/blueprint_forge
# PT: Usuário da aplicação (16+ letras ou dígitos). EN: Application user (16+ letters or digits).
BF_APP_DB_PASSWORD=ChangeMeAppPassword123
DATABASE_URL=postgres://bf_app:ChangeMeAppPassword123@127.0.0.1:5433/blueprint_forge

BF_BIND=127.0.0.1:8080
BF_GAME_ASSETS_DIR=game-assets
BF_ALLOWED_ORIGIN=http://localhost:8080
BF_WEB_DIST=web/dist

# PT: Cadastro: closed (padrão), invite ou open. EN: Registration: closed (default), invite or open.
BF_REGISTRATION=closed
BF_MAX_USERS=50
# PT: Teto global do banco em bytes. EN: Global database cap in bytes.
BF_MAX_DB_BYTES=2147483648
